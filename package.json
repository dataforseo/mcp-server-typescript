{
  "name": "dataforseo-mcp-server",
  "version": "3.0.0-beta.0",
  "description": "CLI and MCP server for DataForSEO API — browse documentation and make authenticated API requests",
  "type": "module",
  "bin": {
    "dataforseo-mcp-server": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataforseo/mcp-server-typescript.git"
  },
  "homepage": "https://github.com/dataforseo/mcp-server-typescript#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/index.ts --cli",
    "dev:mcp": "tsx src/index.ts --mode stdio",
    "dev:mcp:http": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:mcp": "node dist/index.js --mode stdio",
    "start:mcp:http": "node dist/index.js",
    "worker:prebuild": "node scripts/generate-worker-version.cjs && node -e \"try{require('fs').unlinkSync('src/worker/worker-configuration.d.ts')}catch{}\" && wrangler types ./src/worker/worker-configuration.d.ts",
    "worker:build": "npm run worker:prebuild && tsc --project tsconfig.worker.json",
    "worker:dev": "npm run worker:build && wrangler dev",
    "worker:deploy": "npm run worker:build && wrangler deploy",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "keywords": [
    "dataforseo",
    "seo",
    "api",
    "cli",
    "mcp",
    "llm",
    "cloudflare",
    "workers"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "agents": "^0.0.101",
    "commander": "^12.1.0",
    "express": "^4.18.2",
    "wrangler": "^4.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251118.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
